# Leave HOST at 127.0.0.1 for local use. Set your LAN IP for iPhone testing.
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/pocket.sqlite
# Optional: otherwise a random one-time code prints at startup while unconfigured.
# SETUP_CODE=
# Optional sandbox Apple Push Notifications; never commit your .p8 key.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_TOPIC=com.yourname.PocketFamily
# APNS_KEY_PATH=C:/private/AuthKey_XXXXXXXXXX.p8
